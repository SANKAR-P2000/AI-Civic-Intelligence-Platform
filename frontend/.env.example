# ==============================
# AICIP Frontend Environment
# ==============================

# Base URL for the Spring Boot backend API.
# In development, "/api" uses the Vite proxy (see vite.config.js) which
# forwards requests to http://localhost:8080.
# In production, set this to your deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api
